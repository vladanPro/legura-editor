component FormattingEditor(name = "content_document", label = "Content", document = "", fallback = "") {
  return ASX {
    <div class="legura-editor" data-legura-editor="formatting" data-document={document}>
      <div class="legura-editor__toolbar" role="group" aria-label="Text formatting">
        <button
          type="button"
          class="ax-button"
          data-editor-command="bold"
          aria-pressed="false"
          disabled="true"
        >Bold</button>
        <button
          type="button"
          class="ax-button"
          data-editor-command="italic"
          aria-pressed="false"
          disabled="true"
        >Italic</button>
        <button type="button" class="ax-button" data-editor-command="undo" disabled="true">Undo</button>
        <button type="button" class="ax-button" data-editor-command="redo" disabled="true">Redo</button>
      </div>
      <label class="legura-editor__label">
        <span>{label}</span>
        <textarea class="legura-editor__input" data-editor-input="true" rows="12" readonly="true">{fallback}</textarea>
      </label>
      <input type="hidden" name={name} data-editor-document="true" disabled="true" />
      <p class="legura-editor__hint">Select text to apply bold or italic. Formatting is shown in the preview below.</p>
      <p data-editor-error="true" role="status" aria-live="polite"></p>
      <div
        class="legura-editor__preview"
        data-editor-preview="true"
        role="region"
        aria-label="Formatted preview"
      ></div>
      <noscript>
        <p>Editing requires JavaScript. Original content is read-only and will not be submitted.</p>
      </noscript>
    </div>
  }
}
