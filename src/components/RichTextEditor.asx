import { ParagraphIcon } from "@axonyx/ui/foundry/icons/ParagraphIcon"
import { Heading2Icon } from "@axonyx/ui/foundry/icons/Heading2Icon"
import { Heading3Icon } from "@axonyx/ui/foundry/icons/Heading3Icon"
import { ListIcon } from "@axonyx/ui/foundry/icons/ListIcon"
import { OrderedListIcon } from "@axonyx/ui/foundry/icons/OrderedListIcon"
import { BoldIcon } from "@axonyx/ui/foundry/icons/BoldIcon"
import { ItalicIcon } from "@axonyx/ui/foundry/icons/ItalicIcon"
import { LinkIcon } from "@axonyx/ui/foundry/icons/LinkIcon"
import { UnlinkIcon } from "@axonyx/ui/foundry/icons/UnlinkIcon"
import { UndoIcon } from "@axonyx/ui/foundry/icons/UndoIcon"
import { RedoIcon } from "@axonyx/ui/foundry/icons/RedoIcon"

component RichTextEditor(name = "content_document", label = "Content", document = "", fallback = "") {
  return ASX {
    <div class="legura-editor" data-legura-editor="richtext" data-document={document}>
      <span class="legura-editor__label">{label}</span>
      <div class="legura-editor__toolbar" role="group" aria-label="Text formatting">
        <button type="button" class="ax-button" data-editor-command="paragraph" aria-label="Paragraph" title="Paragraph" aria-pressed="false" disabled="true"><ParagraphIcon /></button>
        <button type="button" class="ax-button" data-editor-command="heading-2" aria-label="H2" title="H2" aria-pressed="false" disabled="true"><Heading2Icon /></button>
        <button type="button" class="ax-button" data-editor-command="heading-3" aria-label="H3" title="H3" aria-pressed="false" disabled="true"><Heading3Icon /></button>
        <button type="button" class="ax-button" data-editor-command="unordered-list" aria-label="Bullets" title="Bullets" aria-pressed="false" disabled="true"><ListIcon /></button>
        <button type="button" class="ax-button" data-editor-command="ordered-list" aria-label="Numbered" title="Numbered" aria-pressed="false" disabled="true"><OrderedListIcon /></button>
        <button type="button" class="ax-button" data-editor-command="bold" aria-label="Bold" title="Bold" aria-pressed="false" disabled="true"><BoldIcon /></button>
        <button type="button" class="ax-button" data-editor-command="italic" aria-label="Italic" title="Italic" aria-pressed="false" disabled="true"><ItalicIcon /></button>
        <button type="button" class="ax-button" data-editor-command="link" aria-label="Apply link" title="Apply link" disabled="true"><LinkIcon /></button>
        <button type="button" class="ax-button" data-editor-command="unlink" aria-label="Remove link" title="Remove link" disabled="true"><UnlinkIcon /></button>
        <button type="button" class="ax-button" data-editor-command="undo" aria-label="Undo" title="Undo" disabled="true"><UndoIcon /></button>
        <button type="button" class="ax-button" data-editor-command="redo" aria-label="Redo" title="Redo" disabled="true"><RedoIcon /></button>
      </div>
      <textarea class="legura-editor__input" data-editor-input="true" aria-label={label} rows="12" readonly="true">{fallback}</textarea>
      <input type="hidden" name={name} data-editor-document="true" disabled="true" />
      <div class="legura-editor__preview legura-editor__surface" data-editor-preview="true" role="textbox" aria-label={label} aria-multiline="true" contenteditable="false" tabindex="0"></div>
      <label class="legura-editor__link-label">Link address <input type="text" inputmode="url" data-editor-link="true" placeholder="https://example.com" disabled="true" /></label>
      <p data-editor-error="true" role="status" aria-live="polite"></p>
      <noscript><p>Original content is read-only and will not be submitted.</p></noscript>
    </div>
  }
}
